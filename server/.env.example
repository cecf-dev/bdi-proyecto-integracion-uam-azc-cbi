# ===================================
# BDI Server - Variables de Entorno
# ===================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a Git.

# Servidor
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=bdi_db

# Groq API (Qwen 3.8 27B Vision)
GROQ_API_KEY=tu_groq_api_key_aqui

# SerpApi (Google Shopping)
SERPAPI_KEY=tu_serpapi_key_aqui

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# JWT
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# Notificaciones por correo (Nodemailer + SMTP Gmail)
# Usa una App Password de Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo_gmail@gmail.com
SMTP_PASS=tu_app_password_de_gmail
EMAIL_FROM=tu_correo_gmail@gmail.com

# Scheduler de recordatorios diarios de caducidad
# true = envía automáticamente a las 08:00 (America/Mexico_City)
NOTIF_CRON_ENABLED=false
NOTIF_CRON_SCHEDULE=0 8 * * *
NOTIF_CRON_TIMEZONE=America/Mexico_City
